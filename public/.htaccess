# V-MILLION — document root público do Laravel.
# app/, config/, database/, resources/, storage/ e realtime/ ficam FORA desta
# pasta por desenho do framework — não são alcançáveis por HTTP.

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # ------------------------------------------------------------------
    # Redirecionamento HTTP -> HTTPS
    # ------------------------------------------------------------------
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # ------------------------------------------------------------------
    # Bloqueio de qualquer ficheiro ou pasta cujo nome comece por "." (ex:
    # .git, .claude, .env) — defesa extra caso algum apareça aqui dentro
    # do document root por engano.
    # ------------------------------------------------------------------
    RewriteCond %{REQUEST_URI} (^|/)\.[^/]+ [NC]
    RewriteRule ^ - [F]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]
</IfModule>

# ------------------------------------------------------------------
# Proxy para o serviço de tempo real (Socket.io, processo Node à parte —
# ver realtime/server.js, porta KG_REALTIME_PORT/3001). Sem isto, o cliente
# tinha de ligar diretamente a http(s)://<host>:3001, e como a página corre
# em HTTPS o browser força wss:// — que falha (ERR_SSL_PROTOCOL_ERROR) porque
# o Node não tem certificado TLS nenhum. Com o proxy, o cliente liga a
# wss://<mesmo-host>/socket.io/ (a mesma origem/certificado da página) e o
# Apache é que fala HTTP simples com o Node em 127.0.0.1:3001.
# Requer mod_proxy, mod_proxy_http e mod_proxy_wstunnel ativos no Apache.
# Tem de vir ANTES do front controller, senão /socket.io/ cai no index.php.
# ------------------------------------------------------------------
<IfModule mod_proxy_wstunnel.c>
    <IfModule mod_rewrite.c>
        RewriteCond %{HTTP:Upgrade} =websocket [NC]
        RewriteRule ^socket\.io/(.*) ws://127.0.0.1:3001/socket.io/$1 [P,L]
    </IfModule>
</IfModule>
<IfModule mod_proxy_http.c>
    <IfModule mod_rewrite.c>
        RewriteCond %{HTTP:Upgrade} !=websocket [NC]
        RewriteRule ^socket\.io/(.*) http://127.0.0.1:3001/socket.io/$1 [P,L]
    </IfModule>
</IfModule>

<IfModule mod_rewrite.c>
    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ------------------------------------------------------------------
# Limites de upload (só têm efeito com mod_php; com PHP-FPM/CGI os mesmos
# valores vêm de public/.user.ini).
#
# O único upload do sistema é o comprovativo de pagamento do condutor,
# validado em 5MB (Condutor\PagamentoController::solicitar). Com o
# upload_max_filesize de omissão (2M) o PHP descartava o ficheiro antes de o
# Laravel o ver e a validação respondia "Anexe o comprovativo" a quem já o
# tinha anexado. A folga acima dos 5MB garante que é a validação — e não o
# PHP — a recusar o que passa do limite.
# ------------------------------------------------------------------
<IfModule mod_php.c>
    php_value upload_max_filesize 6M
    php_value post_max_size 10M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 6M
    php_value post_max_size 10M
</IfModule>

# ------------------------------------------------------------------
# Delimitação administrativa (/assets/geo/*.geojson)
#
# São 180KB de contornos dos 22 concelhos que o mapa pede a cada arranque.
# Comprimido passa a ~50KB — numa ligação móvel de Cabo Verde a diferença
# sente-se no tempo até o mapa ficar delimitado. E como é um traçado
# administrativo (só muda se o país mudar), fica em cache por um ano — o
# pedido leva um ?v= (ver MUNICIPIOS_URL em kg-map.js), que é o que faz um
# traçado novo chegar a quem já tem o antigo guardado.
# ------------------------------------------------------------------
<FilesMatch "\.geojson$">
    <IfModule mod_mime.c>
        AddType application/geo+json .geojson
    </IfModule>
    <IfModule mod_deflate.c>
        SetOutputFilter DEFLATE
    </IfModule>
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=31536000, immutable"
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------
# Sem listagem de diretórios
# ------------------------------------------------------------------
Options -Indexes

# ------------------------------------------------------------------
# Bloqueio de ficheiros sensíveis, caso alguma vez apareçam aqui dentro
# ------------------------------------------------------------------
<FilesMatch "\.(sql|env|log|ini|bak)$">
    Require all denied
</FilesMatch>
